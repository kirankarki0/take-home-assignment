# Django Settings
DJANGO_SECRET_KEY=change-me-in-production-use-a-strong-random-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Provider Settings (mock | gemini)
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
